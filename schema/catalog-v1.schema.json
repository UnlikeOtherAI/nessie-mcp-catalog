{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "entries": {
      "minItems": 1,
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "identity": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "registry"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "kind",
                  "name"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "package"
                  },
                  "registryType": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "identifier": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "component": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "kind",
                  "registryType",
                  "identifier",
                  "component"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "repository"
                  },
                  "repositoryId": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "component": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "kind",
                  "repositoryId",
                  "component"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "remote"
                  },
                  "providerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "component": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "kind",
                  "providerId",
                  "component"
                ],
                "additionalProperties": false
              }
            ]
          },
          "sourceRefs": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "nativeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "path": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 1000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000,
                  "format": "uri"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "license": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "sourceId",
                "nativeId",
                "revision",
                "path",
                "url",
                "digest",
                "license"
              ],
              "additionalProperties": false
            }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "description": {
                "type": "string",
                "maxLength": 4000
              },
              "vendor": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "websiteUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "repositoryUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "documentationUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "categories": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "tags": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            },
            "required": [
              "name",
              "displayName",
              "description",
              "vendor",
              "websiteUrl",
              "repositoryUrl",
              "documentationUrl",
              "categories",
              "tags"
            ],
            "additionalProperties": false
          },
          "remotes": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "transport": {
                  "type": "string",
                  "enum": [
                    "http",
                    "sse"
                  ]
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000,
                  "format": "uri"
                },
                "auth": {
                  "type": "object",
                  "properties": {
                    "method": {
                      "type": "string",
                      "enum": [
                        "none",
                        "bearer",
                        "api_key",
                        "oauth2",
                        "unknown"
                      ]
                    },
                    "headerName": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 100
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "valuePrefix": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "Bearer ",
                            "Token "
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "hint": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 500
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "scopes": {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  },
                  "required": [
                    "method",
                    "headerName",
                    "valuePrefix",
                    "hint",
                    "scopes"
                  ],
                  "additionalProperties": false
                },
                "version": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "transport",
                "url",
                "auth",
                "version"
              ],
              "additionalProperties": false
            }
          },
          "packages": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "registryType": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "identifier": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "version": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "transport": {
                  "type": "string",
                  "enum": [
                    "stdio",
                    "http",
                    "sse",
                    "unknown"
                  ]
                }
              },
              "required": [
                "registryType",
                "identifier",
                "version",
                "transport"
              ],
              "additionalProperties": false
            }
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "active",
              "deprecated",
              "withdrawn"
            ]
          },
          "materialDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "nessieApproved": {
            "type": "boolean"
          },
          "madeByNessie": {
            "type": "boolean"
          },
          "approval": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "policyVersion": {
                    "type": "string",
                    "const": "approval-policy-v1"
                  },
                  "materialDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "testedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "nessieRevision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "suiteRevision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "environment": {
                    "type": "string",
                    "enum": [
                      "isolated-fixture",
                      "scoped-live-readonly"
                    ]
                  },
                  "checks": {
                    "type": "object",
                    "properties": {
                      "compatibility": {
                        "type": "string",
                        "const": "passed"
                      },
                      "readOnlyFunctional": {
                        "type": "string",
                        "const": "passed"
                      },
                      "authScope": {
                        "type": "string",
                        "const": "passed"
                      },
                      "securityReview": {
                        "type": "string",
                        "const": "passed"
                      }
                    },
                    "required": [
                      "compatibility",
                      "readOnlyFunctional",
                      "authScope",
                      "securityReview"
                    ],
                    "additionalProperties": false
                  },
                  "evidenceUrl": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  },
                  "decisionUrl": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  },
                  "limitations": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  }
                },
                "required": [
                  "policyVersion",
                  "materialDigest",
                  "testedAt",
                  "expiresAt",
                  "nessieRevision",
                  "suiteRevision",
                  "environment",
                  "checks",
                  "evidenceUrl",
                  "decisionUrl",
                  "limitations"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "authorship": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "componentId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "repositoryUrl": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "evidenceUrl": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  },
                  "decisionUrl": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  }
                },
                "required": [
                  "componentId",
                  "repositoryUrl",
                  "revision",
                  "evidenceUrl",
                  "decisionUrl"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "identity",
          "sourceRefs",
          "metadata",
          "remotes",
          "packages",
          "lifecycle",
          "materialDigest",
          "nessieApproved",
          "madeByNessie",
          "approval",
          "authorship"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "sequence",
    "entries"
  ],
  "additionalProperties": false
}
