{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "publisher": {
      "type": "string",
      "const": "UnlikeOtherAI/nessie-mcp-catalog"
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "complete": {
      "type": "boolean",
      "const": true
    },
    "catalogPath": {
      "type": "string",
      "const": "dist/catalog.json"
    },
    "catalogSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entryCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000
    },
    "sourceSnapshots": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "registry",
              "markdown",
              "tensorblock"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "adapterVersion": {
            "type": "number",
            "const": 1
          },
          "observations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "const": "complete"
          },
          "snapshotPath": {
            "type": "string",
            "pattern": "^inputs\\/[a-z0-9-]+\\/snapshot\\.(json|md)$"
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "revision",
          "sha256",
          "fetchedAt",
          "license",
          "adapterVersion",
          "observations",
          "status",
          "snapshotPath"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "publisher",
    "sequence",
    "generatedAt",
    "complete",
    "catalogPath",
    "catalogSha256",
    "entryCount",
    "sourceSnapshots"
  ],
  "additionalProperties": false
}
